# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgres://weight:weight@localhost:5432/weight_check

# HTTP bind address of the weight-check backend
BIND_ADDR=127.0.0.1:8787

# Path to the llama-server binary (or just "llama-server" if it is on PATH)
LLAMA_SERVER_BIN=/home/you/llama.cpp/build/bin/llama-server

# Directory scanned (non-recursively) for *.gguf models
MODELS_DIR=/home/you/.models

# Unload the model after this many idle seconds (0 disables the watchdog)
IDLE_TIMEOUT_SECS=600

# Max seconds to wait for llama-server to become healthy after spawning
LLAMA_LOAD_TIMEOUT_SECS=300

RUST_LOG=weight_check=info,tower_http=info
